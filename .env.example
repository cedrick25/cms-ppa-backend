APP_NAME=CMS-PPA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Comma-separated browser origins allowed to call the API. Leave empty to allow any origin.
# CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1:5500

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cms_ppa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Used only while running `php artisan cms:create-user`. Remove CMS_ADMIN_PASSWORD immediately after.
# CMS_ADMIN_NAME=
# CMS_ADMIN_USERNAME=
# CMS_ADMIN_EMAIL=
# CMS_ADMIN_PASSWORD=

# Dashboard times are shown in this timezone. Stored timestamps are always UTC.
# CMS_DISPLAY_TIMEZONE=Asia/Manila
# CMS_SIGN_INS_DASHBOARD_LIMIT=8
# CMS_SIGN_INS_RETENTION_DAYS=90
# CMS_NOTIFICATIONS_DASHBOARD_LIMIT=20
# CMS_NOTIFICATIONS_DOWN_AFTER_FAILURES=2
# CMS_NOTIFICATIONS_READ_RETENTION_DAYS=30
# CMS_NOTIFICATIONS_RETENTION_DAYS=90

# Production system reachability checks (run by `php artisan schedule:run` every minute).
# SYSTEM_STATUS_INTERVAL_MINUTES=5
# SYSTEM_STATUS_TIMEOUT_SECONDS=5
# SYSTEM_STATUS_CONNECT_TIMEOUT_SECONDS=3
# SYSTEM_STATUS_CONCURRENCY=5
# SYSTEM_STATUS_BATCH_SIZE=50
# SYSTEM_STATUS_MAX_BACKOFF_MINUTES=60
# SYSTEM_STATUS_STALE_AFTER_MINUTES=10
# SYSTEM_STATUS_VERIFY_TLS=true

# Read-only audit copy. Database names only; blank skips that source.
# The audit page reads CMS-PPA's copy and does not contact these databases.
# AUDIT_UAMS_DATABASE=ppa_sso
# AUDIT_CMIS_DATABASE=ppa_cmis
# AUDIT_PPIS_DATABASE=pis
# CMS_AUDIT_PER_PAGE=20
# CMS_CMS_AUDIT_PER_PAGE=20
# CMS_AUDIT_SYNC_LIMIT=2000
# CMS_AUDIT_STATEMENT_TIMEOUT_MS=8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
