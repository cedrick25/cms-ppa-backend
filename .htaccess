<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prefer a virtual host whose document root is the public directory.
    # This fallback keeps the rest of the application outside the web root
    # when the site is served from the project directory, as on WAMP.
    RewriteRule ^$ public/ [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
