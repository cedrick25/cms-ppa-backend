# Copy this file to .env in this folder and fill in the values.
# If this database already holds CMS-PPA data, use the same APP_KEY as the old Laravel app.
# A new key makes saved system passwords unreadable.

APP_KEY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cms_ppa
DB_USERNAME=root
DB_PASSWORD=

# Leave empty while developing so any local site can call the API.
# Example: http://localhost,http://127.0.0.1
CORS_ALLOWED_ORIGINS=

# Used only by: java -jar cms-ppa-api.jar create-user
# Remove CMS_ADMIN_PASSWORD from this file after the account is created.
CMS_ADMIN_NAME=
CMS_ADMIN_USERNAME=
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=

CMS_DISPLAY_TIMEZONE=Asia/Manila
CMS_SIGN_INS_DASHBOARD_LIMIT=8
CMS_SIGN_INS_RETENTION_DAYS=90
CMS_NOTIFICATIONS_DASHBOARD_LIMIT=20
CMS_NOTIFICATIONS_DOWN_AFTER_FAILURES=2
CMS_NOTIFICATIONS_READ_RETENTION_DAYS=30
CMS_NOTIFICATIONS_RETENTION_DAYS=90

SYSTEM_STATUS_INTERVAL_MINUTES=5
SYSTEM_STATUS_TIMEOUT_SECONDS=5
SYSTEM_STATUS_CONNECT_TIMEOUT_SECONDS=3
SYSTEM_STATUS_CONCURRENCY=5
SYSTEM_STATUS_BATCH_SIZE=50
SYSTEM_STATUS_MAX_BACKOFF_MINUTES=60
SYSTEM_STATUS_STALE_AFTER_MINUTES=10
SYSTEM_STATUS_VERIFY_TLS=true

# Leave a database name blank to skip that audit source.
AUDIT_UAMS_DATABASE=
AUDIT_CMIS_DATABASE=
AUDIT_PPIS_DATABASE=
CMS_AUDIT_PER_PAGE=20
CMS_CMS_AUDIT_PER_PAGE=20
CMS_AUDIT_SYNC_LIMIT=2000
CMS_AUDIT_STATEMENT_TIMEOUT_MS=8000
BCRYPT_ROUNDS=12
